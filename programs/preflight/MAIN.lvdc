* ***************************************
* *                                     *
* *         PREFLIGHT PROGRAM           *
* *                                     *
* *                                     *
* ***************************************

       TITLE   'PSEUDO VARIABLES'
P.CMSR EQU     (4.063492)   MS TO RTC PULSES

       TITLE   'PREFLIGHT LINKAGES'
       DOGS    0,4,227
PFSCHC HPCDD   0,11,0,005,2,17
       DOGS    0,7,006
GCFIHC HPCDD   0,11,0,002,2,17
       DOGS    0,17,157
GRIHC  HPCDD   0,11,0,000,2,17
       DOGS    0,7,253
OCRLHC HPCDD   4,17,0,274,4,17
       DOGS    0,5,371
AZCHC  HPCDD   0,11,0,012,2,13
       DOGS    0,5,372
IBOLHC HPCDD   0,11,0,005,2,16

       DOGS    0,7,007
FIRMC  BSS     1

       DOGS    0,17,154
CRAIHC HPC     SPARE,D.DATA

       DOGS    0,17,210
INACC  BSS     1
       DOGS    0,17,212
INHC   BSS     1
       DOGS    0,17,214
INPQ   BSS     1
       DOGS    0,17,216
INTH   BSS     1

       TITLE   'DATA SECTOR'
       DOGS    0,3,000
D.DATA TABLE   1
LVOVFL BSS     2            RESERVATION FOR LV BUFFER OVERFLOW

* THE FOLLOWING DATA MUST BE IN SPECIFIED LOCATIONS

       DOG     D.DATA
       DOG     *,*,*+(249)  LOC = 371
V.EMW  BSS     1            ERROR MESSAGE WORD

       DOG     D.DATA
GCOTST OCT     000000000

       TITLE   'MEMORY BUFFERS'
       DOGS    0,4,234
LVBUF  BSS     100
       DOGS    0,6,234
GENBUF BSS     100

       TITLE   'RESIDUAL DATA'

* THE FOLLOWING DATA MUST BE IN SPECIFIED LOCATIONS

       DOGS    0,17,000
D.RESD TABLE   1
       BSS     1            HOP 400 RESERVATION

       DOG     D.RESD
       DOG     *,*,*+(185)  LOC = 271
V.STAT BSS     1            STATUS WORD FOR TELEMETRY

       DOG     D.RESD
       DOG     *,*,*+(186)  LOC = 272
D.VIH  BSS     1            INTERRUPT INHIBIT IMAGE

       DOG     D.RESD
       DOG     *,*,*+(193)  LOC = 301
V.EMR  BSS     1            RAW EMR CONTENTS

       TITLE   'VEHICLE DEPENDENT PARAMETERS'
       DOG     D.RESD
MESMAP OCT     776000000
EMCON1 OCT     777775777

       TITLE   'RESIDUAL SECTOR DATA'
       DOG     D.RESD
       LIT
D.KBSG OCT     400000000
D.KB1  OCT     200000000
D.KB2  OCT     100000000
D.KB3  OCT     040000000
D.KB4  OCT     020000000
D.KB5  OCT     010000000
D.KB6  OCT     004000000
D.KB7  OCT     002000000
D.KB8  OCT     001000000
D.KB9  OCT     000400000
D.KB10 OCT     000200000
D.KB11 OCT     000100000
D.KB12 OCT     000040000
D.KB13 OCT     000020000
D.KB14 OCT     000010000
D.KB15 OCT     000004000
D.KB16 OCT     000002000
D.KB17 OCT     000001000
D.KB18 OCT     000000400
D.KB19 OCT     000000200
D.KB20 OCT     000000100
D.KB21 OCT     000000040
D.KB22 OCT     000000020
D.KB23 OCT     000000010
D.KB24 OCT     000000004
D.KB25 OCT     000000002
D.KSY1 OCT     777740000
D.KSY0 OCT     000037776
D.KONS OCT     777777776
D.KZRO DEC     0            ZERO

INHOPC HPC     INTP,D.DATA
INPTL  BSS     1

       TITLE   'ERROR MESSAGE TABLES'
*              MODE SORT
MSEM0  OCT     000000000    NO ERROR
MSEM1  OCT     001000000    DATA INDICATED WHEN MODE EXPECTED
MSEM2  OCT     001100000    UNACCEPTABLE EMR BIT SET
MSEM3  OCT     001200000    INVALID MODE SELECTED
*              VERIFY AND PREPARE TO LOAD
LVEM1  OCT     211000000    CHARACTER COUNTER 1 FAILURE
LVEM2  OCT     212000000    CHARACTER COUNTER 2 FAILURE
LVEM3  OCT     213000000    CHARACTER COUNTER 3 FAILURE
LVEM4  OCT     214000000    CHARACTER COUNTER 4 FAILURE
LVEM5  OCT     215000000    V BITS DISAGREE
LVEM6  OCT     216000000    TEMP STORAGE ACCIDENTALLY OVERFLOWED
LVEM7  OCT     217000000    MEMORY ERROR DETECTED
*              LOAD
LDEM1  OCT     231000000    LOAD ENTERED WHEN NOT PREP TO LOAD
LDEM2  OCT     231200000    TRIED TO LOAD ILLEGAL ADDRESS
*              INTERRUPT PROCESSING
INEM1  OCT     331000000    UNKNOWN INTERRUPT OCCURRED
INEM2  OCT     332000000    TLC DETECTED
*              READ INPUT DATA
RIEM1  OCT     451000000    MODE INDICATED WHEN DATA EXPECTED
