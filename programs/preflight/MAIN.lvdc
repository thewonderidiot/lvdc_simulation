* ***************************************
* *                                     *
* *         PREFLIGHT PROGRAM           *
* *                                     *
* *                                     *
* ***************************************

       TITLE   'PSEUDO VARIABLES'
P.CMSR EQU     (4.063492)   MS TO RTC PULSES
P.TD1  EQU     (4.350*P.CMSR) REAL TIME TELEMETRY DELAY
P.TIBS EQU     (6.0*.08203125*P.CMSR) REAL TIME TELEMETRY BIAS
P.INST EQU     (12.0*.08203125*P.CMSR) REAL TIME TELM BIAS

       TITLE   'PREFLIGHT LINKAGES'
       DOGS    0,4,227
PFSCHC HPCDD   0,11,0,005,2,17
       DOGS    0,7,006
GCFIHC HPCDD   0,11,0,002,2,17
       DOGS    0,17,157
GRIHC  HPCDD   0,11,0,000,2,17
       DOGS    0,7,253
OCRLHC HPCDD   4,17,0,274,4,17
       DOGS    0,5,371
AZCHC  HPCDD   0,11,0,012,2,13
       DOGS    0,5,372
IBOLHC HPCDD   0,11,0,005,2,16

       DOGS    0,7,007
FIRMC  BSS     1

       DOGS    0,17,154
CRAIHC HPC     SPARE,D.DATA

       DOGS    0,17,210
INACC  BSS     1
       DOGS    0,17,212
INHC   BSS     1
       DOGS    0,17,214
INPQ   BSS     1
       DOGS    0,17,216
INTH   BSS     1

       TITLE   'DATA SECTOR'
       DOGS    0,3,000
D.DATA TABLE   1

* THE FOLLOWING DATA MUST BE IN SPECIFIED LOCATIONS

       DOG     D.DATA
       DOG     *,*,*+(249)  LOC = 371
V.EMW  BSS     1            ERROR MESSAGE WORD

       DOG     D.DATA
GCOTST OCT     000000000
V.TPAT OCT     707070706
D.HTR0 HPC     U.TR00,D.DATA
D.KTD  DEC     (P.TD1-P.INST) DELAY CONSTANT REQUIRED FOR TELM
D.VTD  BSS     1
V.DINT BSS     1
V.DIST BSS     1
V.INTR BSS     1
V.OACZ BSS     1
V.OACY BSS     1
V.OACX BSS     1


       TITLE   'RESIDUAL DATA'

* THE FOLLOWING DATA MUST BE IN SPECIFIED LOCATIONS

       DOGS    0,17,000
D.RESD TABLE   1
       BSS     1            HOP 400 RESERVATION

       DOG     D.RESD
       DOG     *,*,*+(185)  LOC = 271
V.STAT BSS     1            STATUS WORD FOR TELEMETRY

       DOG     D.RESD
       DOG     *,*,*+(186)  LOC = 272
D.VIH  BSS     1            INTERRUPT INHIBIT IMAGE

       DOG     D.RESD
       DOG     *,*,*+(193)  LOC = 301
V.EMR  BSS     1            RAW EMR CONTENTS

       TITLE   'VEHICLE DEPENDENT PARAMETERS'
       DOG     D.RESD
MESMAP OCT     776000000
EMCON1 OCT     777775777

       TITLE   'RESIDUAL SECTOR DATA'
       DOG     D.RESD
       LIT
D.KBSG OCT     400000000
D.KB1  OCT     200000000
D.KB2  OCT     100000000
D.KB3  OCT     040000000
D.KB4  OCT     020000000
D.KB5  OCT     010000000
D.KB6  OCT     004000000
D.KB7  OCT     002000000
D.KB8  OCT     001000000
D.KB9  OCT     000400000
D.KB10 OCT     000200000
D.KB11 OCT     000100000
D.KB12 OCT     000040000
D.KB13 OCT     000020000
D.KB14 OCT     000010000
D.KB15 OCT     000004000
D.KB16 OCT     000002000
D.KB17 OCT     000001000
D.KB18 OCT     000000400
D.KB19 OCT     000000200
D.KB20 OCT     000000100
D.KB21 OCT     000000040
D.KB22 OCT     000000020
D.KB23 OCT     000000010
D.KB24 OCT     000000004
D.KB25 OCT     000000002
D.KSY1 OCT     777740000
D.KSY0 OCT     000037776
D.KONS OCT     777777776
D.KZRO DEC     0            ZERO

INHOPC HPC     INTP,D.DATA

       TITLE   'ERROR MESSAGE TABLES'
MSEM0  OCT     000000000
MSEM1  OCT     001000000
MSEM2  OCT     001100000
MSEM3  OCT     001200000
INEM1  OCT     331000000
INEM2  OCT     332000000

       TITLE   'TELEMETRY DEFINITIONS'
*                              BTG      PCM    SCL     UNITS
       TELD    V.TPAT,0,001    0600    1400    OCT
*          TELEMETRY PATTERN WORD
       TELD    V.EMW,0,371     0771    1674    OCT
*          ERROR MESSAGE WORD
       TELD    V.DINT,0,445    0646    1522    OCT
*          DISCRETE INPUT REGISTER STATUS
       TELD    V.OACZ,0,501    0702    1540            .05 M/SEC
*          Z ACCELEROMETER READING
       TELD    V.OACX,0,505    0706    1542            .05 M/SEC
*          X ACCELEROMETER READING
       TELD    V.OACY,0,511    0712    1544            .05 M/SEC
*          Y ACCELEROMETER READING
       TELD    V.DIST,0,545    0746    1562    OCT
*          DISCRETE INPUT SPARES REGISTER STATUS
       TELD    V.INTR,0,565    0766    1572    OCT
*          INTERRUPT REGISTER STATUS
       TELD    V.STAT,0,671    0673    1734    OCT
*          SPECIAL STATUS CODE WORD
       TELD    V.EMR,0,701     0703    1740    OCT
*          ERROR MONITOR REGISTER CONTENTS
